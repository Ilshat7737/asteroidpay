# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# This repo now holds two independent Next.js apps (landing/, payform/),
# each with its own node_modules, .next build output, etc. — these
# patterns are unanchored on purpose so they match inside both.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Claude Code harness state (worktrees, locks) — not part of the app
/.claude/

# typescript
*.tsbuildinfo
next-env.d.ts
